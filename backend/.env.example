# Database (PBX / subtest)
DB_HOST=10.30.0.60
PORT=5432
DB_USER=subadmin
DB_PASSWORD="your-secure-password"
DB_NAME=subtest
DATABASE_URL="postgresql://subadmin:your-secure-password@10.30.0.60:5432/subtest?schema=public"

# Redis
REDIS_HOST=10.30.0.60
REDIS_PORT=6379
REDIS_PASSWORD=

# App
PORT=3000
NODE_ENV=development

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# FreeSWITCH Database (dialplan_xml and did_routes)
FS_DB_HOST=10.30.0.60
FS_DB_PORT=5432
FS_DB_NAME=freeswitch
FS_DB_USER=freeswitch
FS_DB_PASSWORD=your-fs-db-password
KAMAILIO_DB_NAME=kamailio
KAMAILIO_RPC_URL=http://10.30.0.60:8080/rpc
SIP_REALM=pbxv2-dev.balatrix.com

# FreeSWITCH SIP Server
SIP_SERVER=10.30.0.60:5070

# FreeSWITCH Audio Server (SFTP)
FS_AUDIO_HOST=10.30.0.60
FS_AUDIO_USER=soxuser
FS_AUDIO_PASSWORD=your-soxuser-password
FS_AUDIO_BASE_PATH=/opt/ivr_audio

# System Audio file paths (defaults)
AUDIO_SYSTEM_PATH=/opt/ivr_audio/system
AUDIO_INVALID=/opt/ivr_audio/system/invalid_input.wav
AUDIO_UNAVAILABLE=/opt/ivr_audio/system/ext_unavailable.wav
AUDIO_NOINPUT=/opt/ivr_audio/system/ivr_no_input.wav

# Outbound Calling Fallback
# NOTE: Gateways are resolved from the DB (outbound_endpoints table).
# This env var is kept only as a fallback.
OUTBOUND_GATEWAY=sip.telnyx.com:5060

# Barge API
BARGE_API_URL=http://10.30.0.60:8003
BARGE_API_KEY=your-barge-api-key

# Email (Zoho ZeptoMail)
ZEPTOMAIL_API_KEY="your-zeptomail-api-key"
FRONTEND_URL="https://pbxv2-dev.balatrix.com"
PBX_SYNC_TOKEN=your-super-secret-sync-token-change-in-production
SUB_BILLING_API_URL=http://localhost:5005/api

# Cache Flush API (t_2002.py)
CACHE_FLUSH_URL=http://10.30.0.60:8000
CACHE_FLUSH_TOKEN=your-cache-flush-token

# Billing Cache Refresh API
BILLING_CACHE_REFRESH_URL=http://10.30.0.60:8005/api/v1/cache/refresh
BILLING_CACHE_REFRESH_TOKEN=dev-token-123

# Analytics Engine
ANALYTICS_ENGINE_URL=http://10.30.0.60:8001

# Call Recordings Storage (SFTP)
FS_RECORDING_HOST=10.30.0.60
FS_RECORDING_PORT=22
FS_RECORDING_USER=recordingadmin
FS_RECORDING_PASSWORD=your-recording-password
FS_RECORDING_BASE_PATH=/recordings
FS_RECORDING_PATH=/opt/recordings

# Enterprise Resource Limits
SYSTEM_LIMIT_EXTENSIONS=500
SYSTEM_LIMIT_IVRS=50
SYSTEM_LIMIT_SCHEDULERS=50
SYSTEM_LIMIT_RING_GROUPS=50
SYSTEM_LIMIT_DID_FORWARDS=50
SYSTEM_LIMIT_TFNS=50
SYSTEM_LIMIT_DIDS=50
# Required: securely set the SAME random secret in PBX and sub-billing deployed .env files.
# Blank is intentional; never commit the real value. Restart both services after setting it.
SUBSCRIPTION_SERVICE_TOKEN=

# Super Admin SIP traces. Use a read-only PostgreSQL account for the existing
# cdr-service database (live_call_event table). Do not point this at PBX Prisma DB.
SIP_TRACE_DATABASE_URL=
# Native Homer coordinator on the same PBX host. Never expose token to Vite.
HOMER_API_BASE_URL=http://127.0.0.1:9088
HOMER_API_TOKEN=

